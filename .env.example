# Copie para ".env" (que o git ignora) e ajuste. Não coloque valores reais neste arquivo.
# O docker compose lê o .env para criar o PostgreSQL; exporte as mesmas variáveis no processo da aplicação.

# Banco de dados (o compose cria o banco com estes valores; a aplicação conecta com eles)
DB_USER=smart_farming
DB_PASSWORD=troque-esta-senha
DB_NAME=smart_farming_db
# DB_HOST=localhost
# DB_PORT=5432

# Segurança: chave que assina os tokens JWT (mínimo de 32 caracteres; use um valor aleatório e secreto)
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Primeiro administrador (criado na subida se ainda não existir nenhum)
# ADMIN_NOME=Administrador
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=troque-esta-senha-tambem

# Opcional: origens do frontend permitidas pelo CORS (separadas por vírgula)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcional: dados de demonstração e simulador (nunca em produção)
# DEMO_DADOS_ENABLED=true
# DEMO_SENHA=senha-dos-usuarios-de-demonstracao
# SIMULADOR_ENABLED=true
